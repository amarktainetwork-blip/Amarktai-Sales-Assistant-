{
  "scripts": {
    "search_candidate": {
      "steps": [
        { "action": "goto", "value": "https://replace-with-genie-search-url" },
        { "action": "fill", "selector": "input[name='search']", "value": "{{leadLabel}}" },
        { "action": "click", "selector": "button[type='submit']" },
        { "action": "expect_visible", "selector": "body" },
        { "action": "screenshot", "selector": "body", "key": "search-candidate" }
      ]
    },
    "read_candidate_history": {
      "steps": [
        { "action": "read_text", "selector": "body", "key": "candidate-history" },
        { "action": "screenshot", "selector": "body", "key": "candidate-history" }
      ]
    },
    "send_template_sms": {
      "steps": [
        { "action": "click", "selector": "REPLACE_SMS_PANEL_SELECTOR" },
        { "action": "click", "selector": "REPLACE_SAVED_SMS_TEMPLATE_SELECTOR" },
        { "action": "expect_visible", "selector": "REPLACE_APPROVED_SMS_SENDER_SELECTOR" },
        { "action": "click", "selector": "REPLACE_SMS_SEND_SELECTOR" },
        { "action": "screenshot", "selector": "body", "key": "sms-confirmation" }
      ]
    },
    "send_template_email": {
      "steps": [
        { "action": "click", "selector": "REPLACE_EMAIL_PANEL_SELECTOR" },
        { "action": "click", "selector": "REPLACE_SAVED_EMAIL_TEMPLATE_SELECTOR" },
        { "action": "expect_visible", "selector": "REPLACE_NONBLANK_SUBJECT_SELECTOR" },
        { "action": "click", "selector": "REPLACE_EMAIL_SEND_SELECTOR" },
        { "action": "screenshot", "selector": "body", "key": "email-confirmation" }
      ]
    },
    "send_template_whatsapp": {
      "steps": [
        { "action": "click", "selector": "REPLACE_WHATSAPP_PANEL_SELECTOR" },
        { "action": "click", "selector": "REPLACE_SAVED_WHATSAPP_TEMPLATE_SELECTOR" },
        { "action": "click", "selector": "REPLACE_WHATSAPP_SEND_SELECTOR" },
        { "action": "screenshot", "selector": "body", "key": "whatsapp-confirmation" }
      ]
    },
    "add_note": {
      "steps": [
        { "action": "click", "selector": "REPLACE_NOTES_PANEL_SELECTOR" },
        { "action": "fill", "selector": "REPLACE_NOTE_INPUT_SELECTOR", "value": "{{content}}" },
        { "action": "click", "selector": "REPLACE_NOTE_SAVE_SELECTOR" },
        { "action": "screenshot", "selector": "body", "key": "note-confirmation" }
      ]
    },
    "complete_active_task": {
      "steps": [
        { "action": "click", "selector": "REPLACE_ACTIVE_TASK_SELECTOR" },
        { "action": "expect_visible", "selector": "REPLACE_OPEN_TASK_STATUS_SELECTOR" },
        { "action": "click", "selector": "REPLACE_COMPLETE_TASK_SELECTOR" },
        { "action": "screenshot", "selector": "body", "key": "task-completion" }
      ]
    },
    "create_next_task": {
      "steps": [
        { "action": "click", "selector": "REPLACE_CREATE_TASK_SELECTOR" },
        { "action": "fill", "selector": "REPLACE_TASK_TITLE_SELECTOR", "value": "{{taskTitle}}" },
        { "action": "click", "selector": "REPLACE_TASK_SAVE_SELECTOR" },
        { "action": "screenshot", "selector": "body", "key": "task-created" }
      ]
    },
    "update_current_opportunity": {
      "steps": [
        { "action": "click", "selector": "REPLACE_CURRENT_OPEN_OPPORTUNITY_SELECTOR" },
        { "action": "click", "selector": "REPLACE_STAGE_SELECTOR" },
        { "action": "click", "selector": "REPLACE_APPROVED_STAGE_OPTION_SELECTOR" },
        { "action": "click", "selector": "REPLACE_OPPORTUNITY_SAVE_SELECTOR" },
        { "action": "screenshot", "selector": "body", "key": "opportunity-updated" }
      ]
    },
    "update_contact_status": {
      "steps": [
        { "action": "click", "selector": "REPLACE_CONTACT_STATUS_SELECTOR" },
        { "action": "click", "selector": "REPLACE_APPROVED_STATUS_OPTION_SELECTOR" },
        { "action": "click", "selector": "REPLACE_CONTACT_SAVE_SELECTOR" },
        { "action": "screenshot", "selector": "body", "key": "contact-status" }
      ]
    },
    "apply_sequence": {
      "steps": [
        { "action": "click", "selector": "REPLACE_SEQUENCE_SELECTOR" },
        { "action": "click", "selector": "REPLACE_APPROVED_SEQUENCE_OPTION_SELECTOR" },
        { "action": "click", "selector": "REPLACE_SEQUENCE_SAVE_SELECTOR" },
        { "action": "screenshot", "selector": "body", "key": "sequence-applied" }
      ]
    },
    "health_check": {
      "steps": [
        { "action": "expect_visible", "selector": "body" },
        { "action": "screenshot", "selector": "body", "key": "health-check" }
      ]
    },
    "read_test_contact": {
      "steps": [
        { "action": "read_rows", "selector": "REPLACE_CURRENT_CONTACT_ROW_SELECTOR", "key": "targets", "fields": { "externalId": { "selector": "REPLACE_CONTACT_ID_SELECTOR" }, "name": { "selector": "REPLACE_CONTACT_NAME_SELECTOR" }, "email": { "selector": "REPLACE_CONTACT_EMAIL_SELECTOR" } } }
      ]
    },
    "read_tasks": {
      "steps": [
        { "action": "read_rows", "selector": "REPLACE_TASK_ROW_SELECTOR", "key": "records", "fields": { "externalId": { "selector": "REPLACE_TASK_ID_SELECTOR" }, "title": { "selector": "REPLACE_TASK_TITLE_READ_SELECTOR" }, "status": { "selector": "REPLACE_TASK_STATUS_SELECTOR" } } }
      ]
    },
    "read_opportunities": {
      "steps": [
        { "action": "read_rows", "selector": "REPLACE_OPPORTUNITY_ROW_SELECTOR", "key": "targets", "fields": { "externalId": { "selector": "REPLACE_OPPORTUNITY_ID_SELECTOR" }, "name": { "selector": "REPLACE_OPPORTUNITY_NAME_SELECTOR" }, "stage": { "selector": "REPLACE_OPPORTUNITY_STAGE_READ_SELECTOR" } } }
      ]
    },
    "verify_note": {
      "steps": [
        { "action": "read_text", "selector": "REPLACE_LATEST_NOTE_SELECTOR", "key": "noteBody" }
      ]
    },
    "verify_task": {
      "steps": [
        { "action": "read_text", "selector": "REPLACE_LATEST_TASK_TITLE_SELECTOR", "key": "taskTitle" }
      ]
    },
    "verify_opportunity": {
      "steps": [
        { "action": "read_text", "selector": "REPLACE_OPPORTUNITY_STAGE_READ_SELECTOR", "key": "stage" }
      ]
    }
  },
  "operationDefinitions": {
    "contact.search": {
      "definition": { "mode": "read", "executeScript": "search_candidate" },
      "prerequisites": { "knownGeniePack": true }
    },
    "contact.read": {
      "definition": { "mode": "read", "executeScript": "read_test_contact", "resultKey": "targets" },
      "prerequisites": { "knownGeniePack": true }
    },
    "task.list": {
      "definition": { "mode": "read", "executeScript": "read_tasks", "resultKey": "records" },
      "prerequisites": { "knownGeniePack": true }
    },
    "opportunity.read": {
      "definition": { "mode": "read", "executeScript": "read_opportunities", "resultKey": "targets" },
      "prerequisites": { "knownGeniePack": true }
    },
    "note.create": {
      "definition": { "mode": "write", "targetReadScript": "read_test_contact", "executeScript": "add_note", "postconditionReadScript": "verify_note" },
      "targetAssertions": { "mode": "must_match" },
      "postconditionAssertions": [{ "actualKey": "noteBody", "expectedInput": "content", "comparator": "contains" }]
    },
    "task.create_callback": {
      "definition": { "mode": "write", "targetReadScript": "read_test_contact", "executeScript": "create_next_task", "postconditionReadScript": "verify_task" },
      "targetAssertions": { "mode": "must_match" },
      "postconditionAssertions": [{ "actualKey": "taskTitle", "expectedInput": "taskTitle", "comparator": "contains" }]
    },
    "opportunity.update": {
      "definition": { "mode": "write", "targetReadScript": "read_opportunities", "executeScript": "update_current_opportunity", "postconditionReadScript": "verify_opportunity" },
      "targetAssertions": { "mode": "must_match" },
      "postconditionAssertions": [{ "actualKey": "stage", "expectedInput": "stage", "comparator": "equals" }]
    }
  }
}
