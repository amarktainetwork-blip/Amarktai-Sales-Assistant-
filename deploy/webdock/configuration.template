# Copy this file to .env at the repository root during Webdock installation.
# Keep it private: deploy/webdock/install.sh enforces mode 0600.

# Deployment profile:
#   AMARKTAI_DEPLOY_PROFILE=pilot sh deploy/webdock/install.sh
#   AMARKTAI_DEPLOY_PROFILE=full  sh deploy/webdock/install.sh

DOMAIN=assistant.example.com
DB_PASSWORD=replace_with_a_long_random_database_password
DB_ROOT_PASSWORD=replace_with_a_different_long_random_root_password
REDIS_URL=redis://redis:6379

# Full profile builds internal Chromium/CDP. Pilot mode needs an external authorised CDP endpoint.
BROWSERLESS_WS_ENDPOINT=

# Application security
JWT_SECRET=replace_with_a_long_random_jwt_secret
SECRET_KEY=replace_with_a_long_random_application_secret
APP_PUBLIC_URL=https://assistant.example.com
# Exactly 32 random bytes encoded in base64: openssl rand -base64 32
CONNECTION_SECRETS_MASTER_KEY=replace_with_base64_encoded_32_byte_key
CONNECTION_SECRETS_KEY_VERSION=v1
VITE_APP_TITLE=Amarktai Sales Assistant
AUTH_MODE=local
VITE_AUTH_MODE=local
LOCAL_ADMIN_NAME=Amarktai Administrator
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=replace_with_a_long_unique_admin_password
LOCAL_ADMIN_PLATFORM_OWNER=true
MANAGEMENT_ELEVATION_TTL_MINUTES=45

# Mandatory generative/reasoning service
GENX_CHAT_COMPLETIONS_URL=https://your-genx-endpoint.example/v1/chat/completions
GENX_API_KEY=replace_with_your_genx_api_key
GENX_DEFAULT_MODEL=replace_with_an_approved_genx_model_id
GENX_FAST_MODEL=
GENX_REASONING_MODEL=
# Optional whole-site learning overrides. Leave blank for live catalogue selection.
GENX_COMPANY_LEARNING_BASE_URL=
GENX_COMPANY_LEARNING_MODEL=
GENX_COMPANY_AUDIT_MODEL=
GENX_COMPANY_TIMEOUT_MS=180000
GENX_COMPANY_RETRY_COUNT=1
GENX_MAX_OUTPUT_TOKENS=900
GENX_MAX_CONTEXT_CHARS=24000
GENX_TIMEOUT_MS=15000

# Live Call Companion speech-to-text. The full Compose profile injects the
# internal whisper.cpp values below. Change these only for an explicitly
# commissioned OpenAI-compatible external fallback.
STT_PROVIDER_LABEL=Self-hosted whisper.cpp b4938
STT_TRANSCRIPTIONS_URL=http://stt:8080/inference
STT_HEALTH_URL=http://stt:8080/
STT_API_KEY=
STT_MODEL=ggml-base-q5_1
STT_MAX_CONCURRENCY=1
STT_MAX_QUEUE=8
STT_TIMEOUT_MS=45000

# Internal Piper text-to-speech. Voice assets are pinned and checksum verified
# in deploy/tts/Dockerfile; neither voice service has a public port.
TTS_PROVIDER_LABEL=Self-hosted Piper 1.7.0
TTS_BASE_URL=http://tts:5000
TTS_DEFAULT_VOICE=en_US-lessac-medium
TTS_APPROVED_VOICES=en_US-lessac-medium

# Native OAuth CRM applications register exactly:
#   ${APP_PUBLIC_URL}/api/crm/oauth/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_BASE=https://login.salesforce.com
SALESFORCE_API_VERSION=v67.0

PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Secure CRM Browser. Customers authenticate directly in the managed session.
GENIE_LOGIN_URL=https://your-genie-login-url.example

# Personal mailbox (optional; Microsoft delegated OAuth is the first adapter).
# Every user connects their own mailbox. Never configure a shared sender account.
# Register exactly ${APP_PUBLIC_URL}/api/mailbox/microsoft/callback in Entra ID.
OUTLOOK_DELEGATED_TENANT_ID=
OUTLOOK_DELEGATED_CLIENT_ID=
OUTLOOK_DELEGATED_CLIENT_SECRET=
OUTLOOK_DELEGATED_REDIRECT_URI=https://assistant.example.com/api/mailbox/microsoft/callback
PERSONAL_MAILBOX_SYNC_INTERVAL_MS=60000
PERSONAL_WORK_LEARNING_INTERVAL_MS=1800000

# SMTP is mandatory for Amarktai login second factor, password recovery,
# invitations and reports. Client sales communication is performed through
# the connected CRM's own verified functions, not through deployment-level
# SMS/WhatsApp gateways or SMTP fallbacks.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=Amarktai Sales Assistant <no-reply@example.com>
# Optional public contact-form destination. Falls back to LOCAL_ADMIN_EMAIL.
CONTACT_RECIPIENT_EMAIL=

ALLOW_MANUAL_PLAN_ASSIGNMENT=false
