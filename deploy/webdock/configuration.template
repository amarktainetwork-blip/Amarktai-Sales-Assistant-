# Copy this file to .env at the repository root during Webdock installation.
# Keep it private: deploy/webdock/install.sh enforces mode 0600.

# Deployment profile is selected in the shell when running install.sh:
#   AMARKTAI_DEPLOY_PROFILE=pilot ./deploy/webdock/install.sh
#   AMARKTAI_DEPLOY_PROFILE=full  ./deploy/webdock/install.sh

# Public network and persistent data
DOMAIN=assistant.example.com
DB_PASSWORD=replace_with_a_long_random_database_password
DB_ROOT_PASSWORD=replace_with_a_different_long_random_root_password
REDIS_URL=redis://redis:6379

# Full profile: local Browserless Chromium
BROWSERLESS_TOKEN=replace_with_a_long_random_browser_token
# Pilot profile: external Browserless websocket URL, including provider token when required.
# Example shape only: wss://provider.example?token=...
BROWSERLESS_WS_ENDPOINT=

# Application security
JWT_SECRET=replace_with_a_long_random_jwt_secret
SECRET_KEY=replace_with_a_long_random_application_secret
APP_PUBLIC_URL=https://assistant.example.com
# Exactly 32 random bytes encoded in base64; generate with: openssl rand -base64 32
CONNECTION_SECRETS_MASTER_KEY=replace_with_base64_encoded_32_byte_key
CONNECTION_SECRETS_KEY_VERSION=v1
VITE_APP_TITLE=Amarktai Sales Assistant
AUTH_MODE=local
VITE_AUTH_MODE=local
LOCAL_ADMIN_NAME=Amarktai Administrator
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=replace_with_a_long_unique_admin_password

# GenX model router — all generative/reasoning AI stays behind this abstraction.
GENX_CHAT_COMPLETIONS_URL=https://your-genx-endpoint.example/v1/chat/completions
GENX_API_KEY=replace_with_your_genx_api_key
GENX_DEFAULT_MODEL=replace_with_an_approved_genx_model_id
# Optional token-economy controls. Defaults are conservative when omitted.
GENX_FAST_MODEL=
GENX_REASONING_MODEL=
GENX_MAX_OUTPUT_TOKENS=900
GENX_MAX_CONTEXT_CHARS=24000

# HubSpot OAuth — create a public app and register:
#   ${APP_PUBLIC_URL}/api/crm/oauth/callback
# The adapter uses HubSpot's 2026-03 OAuth/token and CRM API families.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Genie CRM browser automation — no Genie API key is used.
# These install-wide values support the first authorised Genie pilot. The SaaS architecture
# must continue moving authenticated browser state to organisation-scoped encrypted sessions.
GENIE_LOGIN_URL=https://your-genie-login-url.example
GENIE_USERNAME=replace_with_genie_username
GENIE_PASSWORD=replace_with_genie_password
GENIE_USERNAME_SELECTOR=input[name="username"]
GENIE_PASSWORD_SELECTOR=input[type="password"]
GENIE_LOGIN_SUBMIT_SELECTOR=button[type="submit"]
GENIE_DASHBOARD_SELECTOR=body

# Microsoft Outlook / Microsoft Graph (optional until activated)
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# SMTP: required for email second-factor codes and email reports
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=Amarktai Sales Assistant <no-reply@example.com>

# Optional external channels: configure only when their delivery bridge is implemented
SMS_PROVIDER_KEY=
